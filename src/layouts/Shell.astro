---
import { formatDate, formatMonth, getJournalDates } from '../data/journal';
import '../styles/global.css';

const db = (Astro.locals as any).runtime?.env?.DB;
const journalDates = await getJournalDates(db);

const months = journalDates.reduce<Record<string, string[]>>((groups, date) => {
  const month = date.slice(0, 7);
  (groups[month] ??= []).push(date);
  return groups;
}, {});

let latestActivityDate: string | null = null;
if (db) {
  try {
    const lastRun = await db.prepare("SELECT finished_at, started_at FROM runs ORDER BY started_at DESC LIMIT 1").first();
    const lastEvent = await db.prepare("SELECT recorded_at FROM events ORDER BY recorded_at DESC LIMIT 1").first();
    const rawTs = lastRun?.finished_at || lastRun?.started_at || lastEvent?.recorded_at;
    if (rawTs) {
      latestActivityDate = String(rawTs).slice(0, 10);
    }
  } catch {}
}

const displayUpdateDate = latestActivityDate || journalDates[0];
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Extrapolation Capital</title>
  </head>
  <body>
    <div class="site-shell">
      <aside class="sidebar">
        <a class="wordmark" href="/">Extrapolation<br />Capital</a>
        <p class="sidebar-intro">A paper-traded options research journal studying streaks, mean reversion, and extrapolation bias.</p>
        <nav aria-label="Primary navigation">
          <a class:list={{ active: currentPath === '/' || currentPath === '' }} href="/">Overview</a>
          <a class:list={{ active: currentPath.includes('/positions/active') }} href="/positions/active">Active Positions</a>
          <a class:list={{ active: currentPath.includes('/scoreboard') }} href="/scoreboard">Scoreboard</a>
          <p class="nav-heading">Journal</p>
          {Object.entries(months).map(([month, dates], index) => (
            <details open={index === 0} class="month-folder">
              <summary><span>{formatMonth(month)}</span><span class="count">{dates.length}</span></summary>
              <div class="date-list">
                {dates.map((date) => <a class:list={{ active: currentPath.includes(`/journal/${date}`) }} href={`/journal/${date}`}>{date.slice(8)}</a>)}
              </div>
            </details>
          ))}
        </nav>
        <div class="sidebar-footer"><span class="status-dot"></span> Paper only · {displayUpdateDate ? 'updated ' + formatDate(displayUpdateDate) : 'awaiting first event'}</div>
      </aside>
      <main class="main-content"><slot /></main>
    </div>
  </body>
</html>
