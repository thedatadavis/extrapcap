---
import Shell from '../../layouts/Shell.astro';

const cookie = Astro.cookies.get('xpc_admin');
if (!cookie?.value || cookie.value !== 'authenticated') {
  return Astro.redirect('/admin/login');
}

const db = (Astro.locals as any).runtime?.env?.DB;
let runs: any[] = [];
let positions: any[] = [];
let eventsCount = 0;
let barsCount = 0;

if (db) {
  try {
    const runsRes = await db.prepare('SELECT * FROM runs ORDER BY started_at DESC LIMIT 25').all();
    runs = runsRes.results || [];

    const posRes = await db.prepare('SELECT * FROM positions ORDER BY opened_at DESC').all();
    positions = posRes.results || [];

    const evtCountRes = await db.prepare('SELECT COUNT(*) as cnt FROM events').first();
    eventsCount = evtCountRes?.cnt || 0;

    const barsCountRes = await db.prepare('SELECT COUNT(*) as cnt FROM bars').first();
    barsCount = barsCountRes?.cnt || 0;
  } catch (err) {
    console.error('Error loading admin stats:', err);
  }
}

const coreWorkflows = [
  { name: 'candidate_review', label: 'Candidate Review', icon: '🎯', desc: 'Market-hours option entry reviews' },
  { name: 'position_management', label: 'Position Management', icon: '📈', desc: 'Held positions profit & exit checks' },
  { name: 'reconciliation', label: 'Reconciliation', icon: '⚖️', desc: 'Paper account equity & cash sync' },
  { name: 'daily_report', label: 'Daily Report', icon: '📊', desc: 'EOD operations report & email summary' },
  { name: 'data_refresh', label: 'Data Refresh', icon: '🔄', desc: 'Daily market bars & universe refresh' },
  { name: 'streak_screen', label: 'Streak Screen', icon: '⚡', desc: 'Screen greenlist into tradable basket' },
];
---

<Shell>
  <header class="topbar">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <a href="/" class="back-link">← Public Dashboard</a>
      <span class="sep">/</span>
      <span>Management Console</span>
    </div>
    <form method="POST" action="/admin/logout" style="margin: 0;">
      <button type="submit" style="background: none; border: none; color: var(--muted); cursor: pointer; font-size: 11px; font-family: var(--mono);">Logout</button>
    </form>
  </header>

  <section class="dashboard-intro">
    <h1>Admin Console 🔒</h1>
    <p>Real-time D1 system state, Modal execution runs, and core workflow controls.</p>
  </section>

  <!-- Health & Stats Overview -->
  <section class="dashboard-section" style="padding-bottom: 28px;">
    <div class="metric-grid">
      <div class="metric">
        <span>Events Recorded</span>
        <strong>{eventsCount.toLocaleString()}</strong>
        <small>D1 ledger events</small>
      </div>
      <div class="metric">
        <span>Active Positions</span>
        <strong>{positions.filter(p => p.is_active).length}</strong>
        <small>Open options spreads</small>
      </div>
      <div class="metric">
        <span>Stock Bars</span>
        <strong>{barsCount.toLocaleString()}</strong>
        <small>Daily bars in D1</small>
      </div>
      <div class="metric">
        <span>Workflow Runs</span>
        <strong>{runs.length}</strong>
        <small>Modal crons tracked</small>
      </div>
    </div>
  </section>

  <!-- Core Workflow Trigger Controls -->
  <section class="trades-section" style="padding-bottom: 36px;">
    <div class="section-heading">
      <div>
        <h2>Core Workflow Controls</h2>
        <p>Trigger core strategy processes on-demand and log rich run metadata to D1</p>
      </div>
    </div>
    <div class="workflow-trigger-grid">
      {coreWorkflows.map((wf) => (
        <div class="workflow-trigger-card">
          <div class="wf-card-header">
            <span class="wf-icon">{wf.icon}</span>
            <strong class="wf-title">{wf.label}</strong>
          </div>
          <p class="wf-desc">{wf.desc}</p>
          <button
            type="button"
            class="trigger-wf-btn"
            data-workflow={wf.name}
            data-label={wf.label}
          >
            Trigger {wf.label}
          </button>
        </div>
      ))}
    </div>
    <div id="trigger-alert" class="trigger-alert-box" hidden></div>
  </section>

  <!-- Workflow Runs Table with Rich Metadata -->
  <section class="trades-section">
    <div class="section-heading">
      <div>
        <h2>Modal Workflow Execution Runs & Metadata</h2>
        <p>Execution logs, run metadata summaries, and status tracking stored in D1</p>
      </div>
    </div>
    {runs.length > 0 ? (
      <div class="trade-table-wrap">
        <table class="trade-table">
          <thead>
            <tr>
              <th>Started</th>
              <th>Workflow</th>
              <th>Status</th>
              <th>Duration</th>
              <th>Run ID</th>
              <th>Run Metadata / Summary</th>
            </tr>
          </thead>
          <tbody>
            {runs.map((r) => (
              <tr>
                <td style="white-space: nowrap;">{r.started_at ? r.started_at.replace('T', ' ').slice(0, 19) : '—'}</td>
                <td><strong>{r.workflow}</strong></td>
                <td>
                  <span class:list={['action-pill', r.status === 'completed' ? '' : r.status === 'failed' ? 'exit' : 'neutral']}>
                    {r.status}
                  </span>
                </td>
                <td>{r.duration_s !== null && r.duration_s !== undefined ? `${r.duration_s.toFixed(1)}s` : '—'}</td>
                <td style="font-family: var(--mono); font-size: 11px; color: var(--muted);">{r.run_id}</td>
                <td style="font-family: var(--mono); font-size: 10px; color: var(--ink); max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  {r.summary || r.error || '—'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="empty-state">No workflow runs recorded in D1 yet. Modal functions will register here on first execution.</div>
    )}
  </section>

  <!-- Active Positions Management -->
  <section class="trades-section" style="padding-top: 18px;">
    <div class="section-heading">
      <div>
        <h2>Position Registry</h2>
        <p>Managed positions from paper trading execution engine</p>
      </div>
    </div>
    {positions.length > 0 ? (
      <div class="trade-table-wrap">
        <table class="trade-table">
          <thead>
            <tr>
              <th>Ticker</th>
              <th>Opened</th>
              <th>Short Strike</th>
              <th>Long Strike</th>
              <th>Expiration</th>
              <th>Credit</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {positions.map((p) => (
              <tr>
                <td class="ticker-cell">{p.ticker}</td>
                <td>{p.opened_at}</td>
                <td>${p.short_strike}</td>
                <td>${p.long_strike}</td>
                <td>{p.expiration}</td>
                <td>${p.entry_credit ? p.entry_credit.toFixed(2) : '—'}</td>
                <td>
                  <span class:list={['action-pill', p.is_active ? '' : 'exit']}>
                    {p.is_active ? 'Active' : `Closed (${p.close_reason || 'manual'})`}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="empty-state">No positions currently recorded in D1.</div>
    )}
  </section>
</Shell>

<script>
  const alertBox = document.getElementById('trigger-alert');

  document.querySelectorAll('.trigger-wf-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const workflow = btn.getAttribute('data-workflow');
      const label = btn.getAttribute('data-label');
      if (!workflow) return;

      btn.setAttribute('disabled', 'true');
      btn.textContent = `Triggering...`;

      try {
        const res = await fetch('/api/trigger', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ workflow }),
        });
        const data = await res.json();

        if (alertBox) {
          alertBox.removeAttribute('hidden');
          if (data.success) {
            alertBox.className = 'trigger-alert-box success';
            alertBox.innerHTML = `<strong>✅ ${label} Triggered</strong> · Run ID: <code>${data.run_id}</code> logged to D1 runs table.`;
          } else {
            alertBox.className = 'trigger-alert-box error';
            alertBox.innerHTML = `<strong>⚠️ Trigger Error:</strong> ${data.error || 'Failed to trigger workflow'}`;
          }
        }
      } catch (err: any) {
        if (alertBox) {
          alertBox.removeAttribute('hidden');
          alertBox.className = 'trigger-alert-box error';
          alertBox.innerHTML = `<strong>⚠️ Request Error:</strong> ${err.message}`;
        }
      } finally {
        btn.removeAttribute('disabled');
        btn.textContent = `Trigger ${label}`;
      }
    });
  });
</script>

<style>
  .workflow-trigger-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 16px;
  }
  .workflow-trigger-card {
    background: #eeeee8;
    border: 1px solid rgba(32, 33, 31, 0.08);
    border-radius: 6px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
  }
  .wf-card-header {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .wf-icon {
    font-size: 18px;
  }
  .wf-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }
  .wf-desc {
    font-size: 11px;
    color: var(--muted);
    margin: 0;
    line-height: 1.35;
  }
  .trigger-wf-btn {
    width: 100%;
    padding: 8px 12px;
    background: var(--paper);
    border: 1px solid rgba(32, 33, 31, 0.2);
    border-radius: 4px;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .trigger-wf-btn:hover:not(:disabled) {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .trigger-wf-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .trigger-alert-box {
    padding: 12px 16px;
    border-radius: 4px;
    font-size: 12px;
    font-family: var(--sans);
    margin-top: 8px;
  }
  .trigger-alert-box.success {
    background: #d8e4db;
    color: var(--green);
    border: 1px solid rgba(73, 107, 86, 0.2);
  }
  .trigger-alert-box.error {
    background: #f4e1dd;
    color: var(--red);
    border: 1px solid rgba(155, 94, 80, 0.2);
  }
  .trigger-alert-box code {
    font-family: var(--mono);
    font-size: 11px;
  }
</style>
