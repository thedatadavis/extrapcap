---
import Shell from '../layouts/Shell.astro';
import { accountHistory, executedTrades, formatDate, journal, latestAccount } from '../data/journal';
const base = import.meta.env.BASE_URL;
const recentTrades = executedTrades.map(({ date, trade }) => ({ date, trade })).slice(-8).reverse();
const firstBalance = accountHistory[0]?.balance ?? 0;
const currentBalance = latestAccount?.balance ?? firstBalance;
const balanceChange = currentBalance - firstBalance;
const balanceChangePct = firstBalance ? balanceChange / firstBalance : 0;
---

<Shell>
  <header class="topbar"><span>Account dashboard</span><a href="https://github.com/thedatadavis/extrapcap" aria-label="View source on GitHub">Source ↗</a></header>

  <section class="dashboard-intro">
    <h1>Extrapolation Capital</h1>
    <p>Account balance and recent trading activity from the research system.</p>
  </section>

  <section class="balance-section" aria-labelledby="balance-title">
    <div class="section-heading"><div><h2 id="balance-title">Account balance</h2><p>Recorded portfolio value</p></div><span class="data-note">As of {latestAccount ? formatDate(latestAccount.date) : 'no snapshot'}</span></div>
    <div class="balance-summary"><div><strong class="balance-value">${currentBalance.toLocaleString('en-US', { maximumFractionDigits: 0 })}</strong><span class:list={['balance-change', { negative: balanceChange < 0 }]}>{balanceChange >= 0 ? '+' : '−'}${Math.abs(balanceChange).toLocaleString('en-US', { maximumFractionDigits: 0 })} ({balanceChangePct >= 0 ? '+' : '−'}{Math.abs(balanceChangePct * 100).toFixed(2)}%) since first snapshot</span></div><span class="balance-caption">Cash ${latestAccount?.cash.toLocaleString('en-US', { maximumFractionDigits: 0 }) ?? '—'} · Buying power ${latestAccount?.buyingPower.toLocaleString('en-US', { maximumFractionDigits: 0 }) ?? '—'}</span></div>
    <div class="balance-chart-wrap">
      <canvas id="balance-chart" aria-label="Interactive account balance history"></canvas>
      <div id="balance-tooltip" class="balance-tooltip" role="status" aria-live="polite" hidden></div>
    </div>
    <p class="chart-note">Hover or tap the chart to inspect each recorded balance.</p>
  </section>

  <section class="trades-section" aria-labelledby="trades-title">
    <div class="section-heading"><div><h2 id="trades-title">Recent trades</h2><p>Entries and exits recorded by the system</p></div><a class="text-link" href={`${base}/journal/${journal[0]?.date}/`}>Open journal →</a></div>
    {recentTrades.length > 0 ? (
      <div class="trade-table-wrap"><table class="trade-table"><thead><tr><th scope="col">Date</th><th scope="col">Action</th><th scope="col">Ticker</th><th scope="col">Position</th><th scope="col">Market context</th><th scope="col">Status</th></tr></thead><tbody>{recentTrades.map(({ date, trade }) => <tr><td>{formatDate(date)}</td><td><span class:list={['action-pill', trade.action.toLowerCase()]}>{trade.action}</span></td><td class="ticker-cell">{trade.ticker}</td><td>{trade.description}</td><td>{trade.context}</td><td>{trade.status}</td></tr>)}</tbody></table></div>
    ) : <div class="empty-state">No entries or exits have been recorded yet.</div>}
  </section>

  <footer class="page-footer">The balance history reflects recorded account snapshots. The trade table shows execution records, not screening decisions.</footer>

  <script define:vars={{ accountHistory }}>
    const canvas = document.querySelector('#balance-chart');
    const tooltip = document.querySelector('#balance-tooltip');
    const history = accountHistory;
    let activeIndex = history.length - 1;

    const money = (value) => '$' + Number(value).toLocaleString('en-US', { maximumFractionDigits: 0 });
    const dateLabel = (value) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(value + 'T12:00:00Z'));

    function draw() {
      if (!canvas || history.length === 0) return;
      const rect = canvas.getBoundingClientRect();
      const ratio = window.devicePixelRatio || 1;
      canvas.width = rect.width * ratio;
      canvas.height = rect.height * ratio;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.scale(ratio, ratio);
      const width = rect.width;
      const height = rect.height;
      const padding = { top: 22, right: 18, bottom: 28, left: 18 };
      const values = history.map((item) => Number(item.balance));
      const min = Math.min(...values);
      const max = Math.max(...values);
      const range = max - min || Math.max(max * 0.01, 1);
      const x = (index) => padding.left + (history.length === 1 ? (width - padding.left - padding.right) / 2 : index * (width - padding.left - padding.right) / (history.length - 1));
      const y = (value) => padding.top + (max - value) / range * (height - padding.top - padding.bottom);

      ctx.clearRect(0, 0, width, height);
      ctx.strokeStyle = 'rgba(32, 33, 31, .10)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(padding.left, height - padding.bottom + .5);
      ctx.lineTo(width - padding.right, height - padding.bottom + .5);
      ctx.stroke();

      if (history.length > 1) {
        ctx.beginPath();
        history.forEach((item, index) => index === 0 ? ctx.moveTo(x(index), y(item.balance)) : ctx.lineTo(x(index), y(item.balance)));
        ctx.lineTo(x(history.length - 1), height - padding.bottom);
        ctx.lineTo(x(0), height - padding.bottom);
        ctx.closePath();
        ctx.fillStyle = 'rgba(73, 107, 86, .08)';
        ctx.fill();
      }

      ctx.beginPath();
      history.forEach((item, index) => index === 0 ? ctx.moveTo(x(index), y(item.balance)) : ctx.lineTo(x(index), y(item.balance)));
      ctx.strokeStyle = '#496b56';
      ctx.lineWidth = 2;
      ctx.stroke();

      history.forEach((item, index) => {
        ctx.beginPath();
        ctx.arc(x(index), y(item.balance), index === activeIndex ? 5 : 3, 0, Math.PI * 2);
        ctx.fillStyle = index === activeIndex ? '#20211f' : '#496b56';
        ctx.fill();
      });

      if (tooltip && activeIndex >= 0) {
        tooltip.hidden = false;
        tooltip.innerHTML = `<strong>${money(history[activeIndex].balance)}</strong><span>${dateLabel(history[activeIndex].date)}</span>`;
        const tooltipWidth = 120;
        const left = Math.max(8, Math.min(width - tooltipWidth - 8, x(activeIndex) - tooltipWidth / 2));
        tooltip.style.left = `${left}px`;
        tooltip.style.top = `${Math.max(4, y(history[activeIndex].balance) - 57)}px`;
      }
    }

    function selectPoint(event) {
      if (!canvas || history.length < 2) return;
      const rect = canvas.getBoundingClientRect();
      const position = (event.clientX - rect.left) / rect.width;
      activeIndex = Math.max(0, Math.min(history.length - 1, Math.round(position * (history.length - 1))));
      draw();
    }

    canvas?.addEventListener('pointermove', selectPoint);
    canvas?.addEventListener('pointerdown', selectPoint);
    new ResizeObserver(draw).observe(canvas);
    draw();
  </script>
</Shell>
