---
import Shell from '../../../layouts/Shell.astro';
import { formatDate, getJournal, getSessionPositions, getSessionOrders, type PositionEconomics } from '../../../data/journal';

const { date, ticker } = Astro.params;
const uppercaseTicker = String(ticker || '').toUpperCase();
const db = (Astro.locals as any).runtime?.env?.DB;

const sessionPositions: PositionEconomics[] = await getSessionPositions(db, date);
const pos = sessionPositions.find((p) => p.ticker === uppercaseTicker);

const journal = await getJournal(db, date);
const entry = journal[0];

if (!pos && !entry) {
  return Astro.redirect(`/journal/${date}`);
}

const sessionOrders = await getSessionOrders(db, date);
const tickerOrders = sessionOrders.filter((o) => String(o.ticker || '').toUpperCase() === uppercaseTicker);

// Fallback values if position not recorded in positions table but in events
const quantity = pos?.quantity ?? 1;
const strategyName = pos?.strategy ?? 'Credit Spread';
const entryCredit = pos?.entryCredit ?? 0;
const upfrontPremium = pos?.upfrontPremium ?? entryCredit * 100 * quantity;
const spreadWidth = pos?.spreadWidth ?? 0;
const maxRisk = pos?.maxRisk ?? Math.max(0, (spreadWidth - entryCredit) * 100 * quantity);
const grossMargin = pos?.grossMargin ?? spreadWidth * 100 * quantity;
const maxRocPct = pos?.maxRocPct ?? (maxRisk > 0 ? (upfrontPremium / maxRisk) * 100 : 0);
const exitPrice = pos?.exitPrice;
const costToClose = pos?.costToClose ?? (exitPrice !== null && exitPrice !== undefined ? exitPrice * 100 * quantity : null);
const realizedPnl = pos?.realizedPnl ?? (exitPrice !== null && exitPrice !== undefined ? (entryCredit - exitPrice) * 100 * quantity : null);
const capitalPreserved = pos?.capitalPreserved ?? (realizedPnl !== null && realizedPnl < 0 ? Math.max(0, maxRisk - Math.abs(realizedPnl)) : null);

const pnlColor = realizedPnl !== null ? (realizedPnl >= 0 ? 'var(--green)' : 'var(--red)') : 'var(--ink)';
const pnlSign = realizedPnl !== null && realizedPnl > 0 ? '+' : '';
---

<Shell>
  <header class="topbar">
    <div class="topbar-left">
      <a class="back-link" href={`/journal/${date}`}>← Back to Journal ({formatDate(date || '')})</a>
      <span class="sep" style="margin: 0 8px; color: var(--muted);">/</span>
      <span>{uppercaseTicker} Economic Report</span>
    </div>
    <a href={`/journal/${date}`}>Daily Summary</a>
  </header>

  <article class="journal-page" style="max-width: 880px;">
    <!-- Hero Title -->
    <div style="margin-bottom: 28px;">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 8px;">
        <h1 style="margin: 0; font-size: 32px;">{uppercaseTicker} · Trade Economics</h1>
        <span class:list={['action-pill', pos?.isActive ? 'neutral' : (pos?.closeReason?.includes('profit') ? 'entry' : 'exit')]} style="font-size: 11px; padding: 4px 10px;">
          {pos?.isActive ? 'Active Position' : `Closed · ${pos?.closeReason?.replaceAll('_', ' ') || 'Resolved'}`}
        </span>
      </div>
      <p class="hero-copy" style="max-width: 680px; font-size: 15px;">
        {quantity}x {strategyName} entered on {formatDate(date || '')} with an expiration of {pos?.expiration || 'N/A'}.
      </p>
    </div>

    <!-- 1. The Setup & Signal Conviction -->
    <section class="dashboard-section" style="padding-bottom: 32px;">
      <div class="section-heading">
        <div>
          <h2>1. Setup & Quantitative Conviction</h2>
          <p>Multi-day relative streak metrics and Bayesian mean-reversion model probability</p>
        </div>
      </div>
      <div class="metric-grid" style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));">
        <div class="metric">
          <span>Streak Length</span>
          <strong>{pos?.streakLength ? `${pos.streakLength}d` : '—'}</strong>
          <small>{pos?.streakDirection ? `${pos.streakDirection} streak` : 'Relative streak'}</small>
        </div>
        <div class="metric">
          <span>Robust Z-Score</span>
          <strong>{pos?.robustZ !== undefined ? pos.robustZ.toFixed(2) : '—'}</strong>
          <small>Deviation vs SPY</small>
        </div>
        <div class="metric">
          <span>Reversion Probability</span>
          <strong style="color: var(--green);">{pos?.reversionProbability ? `${(pos.reversionProbability * 100).toFixed(1)}%` : '—'}</strong>
          <small>Bayesian model</small>
        </div>
        <div class="metric">
          <span>Underlying Spot</span>
          <strong>{pos?.underlyingPrice ? `$${pos.underlyingPrice.toFixed(2)}` : '—'}</strong>
          <small>At order generation</small>
        </div>
      </div>
    </section>

    <!-- 2. Option Legs Architecture -->
    <section class="trades-section" style="padding-bottom: 32px;">
      <div class="section-heading">
        <div>
          <h2>2. Option Legs Architecture</h2>
          <p>Vertical credit spread contract specifications and execution fill marks</p>
        </div>
      </div>
      <div class="trade-table-wrap">
        <table class="trade-table">
          <thead>
            <tr>
              <th>Role</th>
              <th>Contract Symbol</th>
              <th>Strike</th>
              <th>Option Type</th>
              <th>Expiration</th>
              <th>Entry Price</th>
              <th>Current/Exit Price</th>
            </tr>
          </thead>
          <tbody>
            {pos?.legs && pos.legs.length > 0 ? (
              pos.legs.map((leg: any) => (
                <tr>
                  <td>
                    <span class:list={['action-pill', leg.side === 'sell' ? 'exit' : 'entry']}>
                      {leg.side === 'sell' ? 'Short Leg' : 'Long Wing'}
                    </span>
                  </td>
                  <td class="ticker-cell"><code>{leg.symbol}</code></td>
                  <td><strong>${Number(leg.strike).toFixed(2)}</strong></td>
                  <td>{String(leg.type || 'P').toUpperCase() === 'P' ? 'Put' : 'Call'}</td>
                  <td>{leg.expiration}</td>
                  <td>${Number(leg.entry_price || 0).toFixed(2)}</td>
                  <td>${Number(leg.current_price || 0).toFixed(2)}</td>
                </tr>
              ))
            ) : (
              <tr>
                <td><span class="action-pill exit">Short Leg</span></td>
                <td><code>{pos?.shortStrike} Strike</code></td>
                <td><strong>${pos?.shortStrike.toFixed(2)}</strong></td>
                <td>Put</td>
                <td>{pos?.expiration}</td>
                <td>—</td>
                <td>—</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 3. Capital & Risk Allocation Breakdown -->
    <section class="dashboard-section" style="padding-bottom: 32px;">
      <div class="section-heading">
        <div>
          <h2>3. Capital & Risk Allocation Economics</h2>
          <p>Detailed margin requirement, cash premium collected, maximum capped loss, and return on capital</p>
        </div>
      </div>
      <div class="metric-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
        <div class="metric">
          <span>Net Entry Credit</span>
          <strong style="color: var(--green);">${entryCredit.toFixed(2)}</strong>
          <small>Per share ($100/contract)</small>
        </div>
        <div class="metric">
          <span>Upfront Cash Collected</span>
          <strong style="color: var(--green);">${upfrontPremium.toLocaleString('en-US', { minimumFractionDigits: 2 })}</strong>
          <small>{quantity} contracts total</small>
        </div>
        <div class="metric">
          <span>Gross Margin Required</span>
          <strong>${grossMargin.toLocaleString('en-US', { minimumFractionDigits: 2 })}</strong>
          <small>${spreadWidth.toFixed(2)} spread width</small>
        </div>
        <div class="metric">
          <span>Max Potential Risk</span>
          <strong style="color: var(--red);">${maxRisk.toLocaleString('en-US', { minimumFractionDigits: 2 })}</strong>
          <small>Capped worst-case loss</small>
        </div>
        <div class="metric">
          <span>Max Return on Capital</span>
          <strong>{maxRocPct.toFixed(1)}%</strong>
          <small>Premium / Max Risk</small>
        </div>
      </div>
    </section>

    <!-- 4. Realized Outcome & Capital Preservation -->
    <section class="dashboard-section" style="padding-bottom: 32px;">
      <div class="section-heading">
        <div>
          <h2>4. Realized Outcome & Capital Preservation</h2>
          <p>Intraday management, stop-loss trigger, realized P&L, and downside capital shielded</p>
        </div>
      </div>

      <div style="background: #eeeee8; padding: 22px 24px; border-radius: 4px; border-left: 3px solid var(--green);">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 16px;">
          <div>
            <span style="display: block; font-family: var(--mono); font-size: 10px; color: var(--muted); text-transform: uppercase;">Exit Fill Price</span>
            <strong style="font-size: 20px; font-family: var(--sans);">
              {exitPrice !== null && exitPrice !== undefined ? `$${exitPrice.toFixed(2)} / sh` : 'Still Open'}
            </strong>
            <small style="display: block; font-family: var(--mono); font-size: 10px; color: var(--muted);">
              {costToClose ? `$${costToClose.toLocaleString('en-US', { minimumFractionDigits: 2 })} to close` : 'Active'}
            </small>
          </div>
          <div>
            <span style="display: block; font-family: var(--mono); font-size: 10px; color: var(--muted); text-transform: uppercase;">Net Realized P&L</span>
            <strong style={`font-size: 20px; font-family: var(--sans); color: ${pnlColor};`}>
              {realizedPnl !== null ? `${pnlSign}$${realizedPnl.toLocaleString('en-US', { minimumFractionDigits: 2 })}` : 'Unrealized'}
            </strong>
            <small style="display: block; font-family: var(--mono); font-size: 10px; color: var(--muted);">
              {realizedPnl !== null && upfrontPremium > 0 ? `${((realizedPnl / upfrontPremium) * 100).toFixed(1)}% of credit` : 'Active'}
            </small>
          </div>
          <div>
            <span style="display: block; font-family: var(--mono); font-size: 10px; color: var(--muted); text-transform: uppercase;">Capital Preserved</span>
            <strong style="font-size: 20px; font-family: var(--sans); color: var(--green);">
              {capitalPreserved !== null ? `+$${capitalPreserved.toLocaleString('en-US', { minimumFractionDigits: 2 })}` : '—'}
            </strong>
            <small style="display: block; font-family: var(--mono); font-size: 10px; color: var(--muted);">
              Shielded vs full max loss
            </small>
          </div>
          <div>
            <span style="display: block; font-family: var(--mono); font-size: 10px; color: var(--muted); text-transform: uppercase;">Resolution Trigger</span>
            <strong style="font-size: 16px; font-family: var(--sans); text-transform: capitalize;">
              {pos?.closeReason?.replaceAll('_', ' ') || (pos?.isActive ? 'Active' : 'Broker closed')}
            </strong>
            <small style="display: block; font-family: var(--mono); font-size: 10px; color: var(--muted);">
              Automated risk rule
            </small>
          </div>
        </div>

        <p style="font-size: 13px; color: #4b4c48; line-height: 1.55; margin: 0; border-top: 1px solid rgba(32,33,31,0.08); padding-top: 12px;">
          <strong>Risk Management Note:</strong> This trade collected <strong>${upfrontPremium.toFixed(2)}</strong> upfront. When the spread widened, the position management system executed the stop-loss discipline, closing the spread at {exitPrice ? `$${exitPrice.toFixed(2)}` : 'market'}. This successfully eliminated tail risk and preserved <strong>${capitalPreserved ? `$${capitalPreserved.toLocaleString('en-US', { minimumFractionDigits: 2 })}` : '$0.00'}</strong> that was otherwise exposed under the full spread width.
        </p>
      </div>
    </section>

    <!-- 5. Order Execution Audit Trail -->
    {tickerOrders.length > 0 && (
      <section class="trades-section" style="padding-top: 12px;">
        <div class="section-heading">
          <div>
            <h2>5. Broker Execution Audit Trail</h2>
            <p>Alpaca paper trading order submissions and fills</p>
          </div>
        </div>
        <div class="trade-table-wrap">
          <table class="trade-table">
            <thead>
              <tr>
                <th>Time (UTC)</th>
                <th>Order ID</th>
                <th>Side</th>
                <th>Qty</th>
                <th>Limit Price</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {tickerOrders.map((ord: any) => (
                <tr>
                  <td>{String(ord.submitted_at || ord.created_at || '').slice(11, 19)}</td>
                  <td class="ticker-cell"><code>{String(ord.client_order_id || ord.broker_order_id || '').slice(0, 16)}...</code></td>
                  <td><span class="action-pill">{ord.side}</span></td>
                  <td>{ord.quantity}</td>
                  <td>${Number(ord.limit_price || 0).toFixed(2)}</td>
                  <td>
                    <span class:list={['action-pill', ord.execution_status === 'filled' ? 'entry' : 'neutral']}>
                      {ord.execution_status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </article>
</Shell>
