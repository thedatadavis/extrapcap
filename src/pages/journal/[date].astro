---
import Shell from '../../layouts/Shell.astro';
import { formatDate, journal, latestAccount, readoutFor } from '../../data/journal';

export function getStaticPaths() {
  return journal.map((entry) => ({ params: { date: entry.date }, props: { entry } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;

// Use structured summary layout for 2026-07-30 and future reports
const isStructuredLayout = entry.date >= '2026-07-30';

// Deduplicate items per ticker — keep the best record per ticker
const tickerMap = new Map();
const evaluatedTickers = new Set();
const gateTickers = new Set();
const probTickers = new Set();
const submittedTickers = new Set();

entry.entries.forEach((item) => {
  const ticker = item.ticker ?? item.selectionContext?.ticker;
  if (!ticker) return;
  evaluatedTickers.add(ticker);

  const ctx = item.selectionContext ?? {};
  const sigGate = ctx.signal_gate ?? {};
  const isGateAllowed = sigGate.allowed === true || item.reason === 'approved' || (ctx.robust_z !== undefined && Math.abs(ctx.robust_z) >= 2.0);
  if (isGateAllowed) gateTickers.add(ticker);

  const prob = item.modelProbability ?? ctx.reversion_probability ?? ctx.model_probability;
  const isProbAllowed = typeof prob === 'number' && prob > 0.51;
  if (isProbAllowed) probTickers.add(ticker);

  if (item.status === 'submitted' || item.kind === 'paper_order' || item.decision === 'go') submittedTickers.add(ticker);

  if (!tickerMap.has(ticker) || isProbAllowed || isGateAllowed) {
    tickerMap.set(ticker, {
      ticker,
      sector: ctx.sector ?? 'Unknown',
      direction: ctx.streak_direction ?? 'flat',
      length: ctx.streak_length ?? 0,
      robustZ: ctx.robust_z,
      prob,
      status: item.status ?? item.decision ?? 'vetoed',
      reason: item.reason ?? 'Vetoed by signal rules',
      isGateAllowed,
      isProbAllowed,
    });
  }
});

const evaluatedCount = evaluatedTickers.size;
const passedGateCount = gateTickers.size;
const passedProbCount = probTickers.size;
const submittedCount = submittedTickers.size;

const clearedGateTickers = Array.from(tickerMap.values()).filter((row) => row.isGateAllowed).sort((a, b) => {
  const probA = typeof a.prob === 'number' ? a.prob : -1;
  const probB = typeof b.prob === 'number' ? b.prob : -1;
  if (probB !== probA) return probB - probA;
  return a.ticker.localeCompare(b.ticker);
});
const tickersTable = clearedGateTickers.length > 0 ? clearedGateTickers : Array.from(tickerMap.values()).slice(0, 14);

const reconciliationItem = entry.entries.find((item) => item.kind === 'reconciliation' || item.positions !== undefined);
const activePositions = reconciliationItem?.positions ?? [];
const openOrders = reconciliationItem?.openOrders ?? [];
---

<Shell>
  <header class="topbar"><a class="back-link" href={`${base}/`}>← Overview</a><span>Daily journal</span></header>
  <article class="journal-page" style={isStructuredLayout ? "max-width:960px;" : ""}>
    <h1>{formatDate(entry.date)}</h1>
    <p class="lede">A plain-language account of market moves considered, evaluation funnel metrics, and options execution records.</p>

    {isStructuredLayout ? (
      <div class="journal-structured">
        {/* 1. Top Level Funnel Summary */}
        <section class="funnel-summary" style="margin-bottom:36px;">
          <h2 style="font-size:18px; margin-bottom:14px;">Evaluation Funnel Summary</h2>
          <div class="metric-grid">
            <div class="metric">
              <span>Evaluated Basket</span>
              <strong>{evaluatedCount}</strong>
              <small>Total Tickers Screened</small>
            </div>
            <div class="metric">
              <span>Streak &amp; Z Gate</span>
              <strong>{passedGateCount}</strong>
              <small>Passed Quantitative Streak</small>
            </div>
            <div class="metric">
              <span>Reversion Prob</span>
              <strong>{passedProbCount}</strong>
              <small>Met P &gt; 51% Threshold</small>
            </div>
            <div class="metric">
              <span>Orders Placed</span>
              <strong>{submittedCount}</strong>
              <small>Paper Orders Submitted</small>
            </div>
          </div>
        </section>

        {/* 2. Final Tickers Evaluated Table */}
        <section class="tickers-table-section" style="margin-bottom:48px;">
          <h2 style="font-size:18px; margin-bottom:6px;">Final Evaluated Tickers &amp; Core Metrics</h2>
          <p class="data-note" style="margin-bottom:14px;">SPY-relative return streaks, robust Z-scores, and Bayesian reversion probabilities for screened tickers.</p>
          <div class="trade-table-wrap">
            <table class="trade-table">
              <thead>
                <tr>
                  <th>Ticker</th>
                  <th>Sector</th>
                  <th>Streak</th>
                  <th>Robust Z</th>
                  <th>Reversion Prob</th>
                  <th>Status</th>
                  <th>Reason</th>
                </tr>
              </thead>
              <tbody>
                {tickersTable.slice(0, 30).map((row) => (
                  <tr class={row.isProbAllowed ? '' : 'row-dimmed'}>
                    <td class="ticker-cell">{row.ticker}</td>
                    <td>{row.sector}</td>
                    <td style="text-transform:capitalize;">{row.direction} · {row.length}d</td>
                    <td style="font-family:var(--mono);">{typeof row.robustZ === 'number' ? (row.robustZ > 0 ? `+${row.robustZ.toFixed(2)}` : row.robustZ.toFixed(2)) : 'N/A'}</td>
                    <td style="font-family:var(--mono);">{typeof row.prob === 'number' ? `${(row.prob * 100).toFixed(2)}%` : 'N/A'}</td>
                    <td>
                      <span class:list={['action-pill', row.status === 'submitted' ? 'entry' : row.status === 'deferred' ? '' : 'exit']}>
                        {row.status}
                      </span>
                    </td>
                    <td style="color:var(--muted); font-size:11px;">{row.reason}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {tickersTable.length > 30 && <p class="chart-note" style="margin-top:8px;">Showing top 30 evaluated candidates out of {tickersTable.length} total screened tickers.</p>}
        </section>

        {/* 3. Written Daily Summary */}
        <section class="written-summary" style="background:#eeeee8; padding:28px 30px; margin-bottom:42px;">
          <h2 style="font-family:var(--serif); font-size:26px; font-weight:400; margin-bottom:14px;">Daily Performance &amp; Rationale Summary</h2>
          <div class="readout-body" style="max-width:100%; display:grid; gap:16px; color:#4b4c48; font-size:15px; line-height:1.65;">
            <p>
              <strong>Market Environment &amp; Signal Screening:</strong> On {formatDate(entry.date)}, the 2-sided Bayesian Fast EV engine evaluated {evaluatedCount} tickers across our active trading basket relative to SPY benchmark returns. {passedGateCount} tickers met quantitative relative-return streak boundaries (|Z| &ge; 2.0){passedProbCount > 0 ? `, and ${passedProbCount} tickers achieved empirical reversion probabilities above the required win probability threshold (P > 0.51).` : `, but all candidates registered empirical reversion probabilities at or below the P \u2264 0.51 threshold.`}
            </p>
            <p>
              <strong>Execution &amp; Capital Protection:</strong> {submittedCount > 0 ? `The system placed ${submittedCount} paper order${submittedCount > 1 ? 's' : ''} today following positive expected value evaluation.` : `Because zero candidate vertical option spreads achieved the positive expected value threshold (EV \u2265 $10.00) after option pricing and spread liquidity screening, the system safely deferred entry and placed 0 new paper orders today, preserving capital in neutral market conditions.`}
            </p>
            <p>
              <strong>Active Position Management:</strong> {activePositions.length === 0 ? `Account reconciliation confirmed 0 active positions held in the Alpaca account. All portfolio equity ($${(latestAccount?.balance ?? 100000).toLocaleString('en-US')}) remains 100% in cash with zero open order or position risk.` : `Monitored ${activePositions.length} active position${activePositions.length > 1 ? 's' : ''} in the Alpaca account under our exit heuristics.`}
            </p>
          </div>
        </section>
      </div>
    ) : (
      <div class="entry-stack">
        {entry.entries.map((item) => {
          const readout = readoutFor(item);
          return (
          <section class="entry-card">
            <div class="entry-meta">
              <span>{readout.label}</span>
              <span class:list={['decision', item.decision]}>{readout.status}</span>
            </div>
            <h2>{readout.headline}</h2>
            <p class="readout-body">{readout.body}</p>
            <details class="technical-details">
              <summary>Technical record</summary>
              <dl>
                <div><dt>Ticker</dt><dd>{item.ticker ?? 'Not applicable'}</dd></div>
                <div><dt>Event</dt><dd>{item.kind === 'paper_order' ? 'order' : item.kind.replaceAll('_', ' ')}</dd></div>
                {item.selectionContext?.sector && <div><dt>Sector</dt><dd>{item.selectionContext.sector}</dd></div>}
                {item.selectionContext?.streak_length !== undefined && <div><dt>Streak</dt><dd>{item.selectionContext.streak_direction} · {item.selectionContext.streak_length} sessions · signed {item.selectionContext.signed_streak}</dd></div>}
                {item.selectionContext?.relative_return !== undefined && <div><dt>Formation</dt><dd>{(Number(item.selectionContext.relative_return) * 100).toFixed(2)}% versus SPY · robust Z {Number(item.selectionContext.robust_z).toFixed(2)}</dd></div>}
                {item.dataTier && <div><dt>Data tier</dt><dd>{item.dataTier}</dd></div>}
                {item.signalId && <div><dt>Signal ID</dt><dd><code>{item.signalId}</code></dd></div>}
                {item.clientOrderId && <div><dt>Client order</dt><dd><code>{item.clientOrderId}</code></dd></div>}
                {item.riskSnapshot?.options_trading_level !== undefined && <div><dt>Account gate</dt><dd>Options Level {item.riskSnapshot.options_trading_level} · {item.riskSnapshot.trading_blocked ? 'blocked' : 'available'}</dd></div>}
                <div><dt>Reason</dt><dd>{item.reason}</dd></div>
              </dl>
              {item.contractIds.length > 0 && <div class="contract-list"><h3>Contract IDs</h3>{item.contractIds.map((contractId) => <p><code>{contractId}</code></p>)}</div>}
            </details>
          </section>
          );
        })}
      </div>
    )}
    <p class="journal-footnote">These entries describe decisions and proposed orders; they do not confirm that an order was filled.</p>
  </article>
</Shell>
