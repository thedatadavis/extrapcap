---
import Shell from '../../layouts/Shell.astro';
import { formatDate, getJournal, readoutFor } from '../../data/journal';

const { date } = Astro.params;
const db = (Astro.locals as any).runtime?.env?.DB;
const journal = await getJournal(db);
const entry = journal.find((e) => e.date === date);

if (!entry) {
  return Astro.redirect('/404');
}

// Use structured summary layout for 2026-07-30 and future reports
const isStructuredLayout = entry.date >= '2026-07-30';

// Deduplicate items per ticker — keep the best record per ticker
const tickerMap = new Map();
const evaluatedTickers = new Set();
const gateTickers = new Set();
const submittedTickers = new Set();
const filledTickers = new Set();

entry.entries.forEach((item) => {
  const ticker = item.ticker ?? item.selectionContext?.ticker;
  if (!ticker) return;
  evaluatedTickers.add(ticker);

  const ctx = item.selectionContext ?? {};
  const sigGate = ctx.signal_gate ?? {};

  const existing = tickerMap.get(ticker);
  const isGateAllowed = sigGate.decision === 'allow' || item.status === 'selected' || existing?.isGateAllowed;

  if (isGateAllowed) gateTickers.add(ticker);

  const prob = typeof item.modelProbability === 'number'
    ? item.modelProbability
    : typeof ctx.reversion_probability === 'number'
      ? ctx.reversion_probability
      : undefined;

  const bestProb = prob !== undefined ? prob : existing?.prob;

  if (item.status === 'submitted' || item.kind === 'paper_order' || item.clientOrderId) {
    submittedTickers.add(ticker);
  }

  if (
    item.status === 'filled' ||
    item.status === 'partially_filled' ||
    item.kind === 'paper_fill' ||
    (item.marketData?.filled_qty !== undefined && item.marketData.filled_qty > 0)
  ) {
    filledTickers.add(ticker);
  }

  const finalStatus = item.status ?? item.decision ?? existing?.status ?? 'vetoed';
  const rawReason = item.reason ?? existing?.reason ?? 'Vetoed by signal rules';
  const finalReason = rawReason === 'candidate_limit' ? 'evaluated' : rawReason;

  tickerMap.set(ticker, {
    ticker,
    sector: ctx.sector ?? existing?.sector ?? 'Unknown',
    direction: ctx.streak_direction ?? existing?.direction ?? 'flat',
    length: ctx.streak_length ?? existing?.length ?? 0,
    robustZ: ctx.robust_z ?? existing?.robustZ,
    prob: bestProb,
    status: finalStatus,
    reason: finalReason,
    isGateAllowed: isGateAllowed || existing?.isGateAllowed || false,
    isProbAllowed: (typeof bestProb === 'number' && bestProb > 0.50) || existing?.isProbAllowed || false,
  });
});

const evaluatedCount = evaluatedTickers.size;
const passedGateCount = gateTickers.size;
const passedProbCount = Array.from(tickerMap.values()).filter(
  (row) => row.isGateAllowed && typeof row.prob === 'number' && row.prob > 0.50
).length;
const submittedCount = submittedTickers.size;
const filledCount = filledTickers.size;

const clearedGateTickers = Array.from(tickerMap.values()).filter((row) => row.isGateAllowed).sort((a, b) => {
  const probA = typeof a.prob === 'number' ? a.prob : -1;
  const probB = typeof b.prob === 'number' ? b.prob : -1;
  if (probB !== probA) return probB - probA;
  return a.ticker.localeCompare(b.ticker);
});
const tickersTable = clearedGateTickers.length > 0 ? clearedGateTickers : Array.from(tickerMap.values()).slice(0, 14);

const reconciliationItem = entry.entries.find((item) => item.kind === 'reconciliation' || item.positions !== undefined);
const activePositions = reconciliationItem?.positions ?? [];
const openOrders = reconciliationItem?.openOrders ?? [];

let wsjSummary: string | null = null;
const dailyReportEvent = entry.entries.find((e) => e.kind === 'daily_report' || e.category === 'reports');
if (dailyReportEvent?.marketData?.wsj_summary) {
  wsjSummary = String(dailyReportEvent.marketData.wsj_summary);
}
---

<Shell>
  <header class="topbar"><a class="back-link" href="/">← Overview</a><span>Daily journal</span></header>
  <article class="journal-page">
    <h1>{formatDate(entry.date)}</h1>
    <p class="lede">A plain-language account of market moves considered, evaluation funnel metrics, and options execution records.</p>

    {isStructuredLayout ? (
      <div>
        {/* 1. Top Level Funnel Summary */}
        <section class="dashboard-section" style="padding-bottom: 36px;">
          <div class="section-heading">
            <div>
              <h2>Evaluation Funnel Summary</h2>
              <p>Mean-reversion candidates, signal filtering, model approvals, and execution</p>
            </div>
          </div>
          <div class="metric-grid" style="grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));">
            <div class="metric"><span>Evaluated</span><strong>{evaluatedCount}</strong><small>Candidates</small></div>
            <div class="metric"><span>Signal Passed</span><strong>{passedGateCount}</strong><small>Cleared streak</small></div>
            <div class="metric"><span>Model Approved</span><strong>{passedProbCount}</strong><small>P(reversion) &gt; 50%</small></div>
            <div class="metric"><span>Orders Submitted</span><strong>{submittedCount}</strong><small>Paper queue</small></div>
            <div class="metric"><span>Filled Trades</span><strong>{filledCount}</strong><small>Broker fills</small></div>
          </div>
        </section>

        {/* 2. Executive Commentary */}
        {wsjSummary && (
          <section class="dashboard-section" style="padding-bottom: 36px;">
            <div class="context-panel" style="background:#eeeee8; padding:20px; border-left:3px solid var(--green);">
              <h2 style="font-size:15px; margin-bottom:8px; color:var(--green);">WSJ Daily Commentary & Portfolio Note</h2>
              <p style="font-size:14px; line-height:1.6; margin:0;">{wsjSummary}</p>
            </div>
          </section>
        )}

        {/* 3. Screened Candidates Breakdown */}
        {tickersTable.length > 0 && (
          <section class="trades-section">
            <div class="section-heading">
              <div>
                <h2>Candidate Screening & Model Decisions</h2>
                <p>Filter state and model win-probability metrics</p>
              </div>
            </div>
            <div class="trade-table-wrap">
              <table class="trade-table">
                <thead>
                  <tr>
                    <th>Ticker</th>
                    <th>Sector</th>
                    <th>Streak</th>
                    <th>Robust Z</th>
                    <th>Model P(reversion)</th>
                    <th>Funnel Stage</th>
                    <th>Decision / Reason</th>
                  </tr>
                </thead>
                <tbody>
                  {tickersTable.map((row) => (
                    <tr>
                      <td class="ticker-cell"><strong>{row.ticker}</strong></td>
                      <td style="font-size:12px; color:var(--muted);">{row.sector}</td>
                      <td>{row.length > 0 ? `${row.length}d (${row.direction})` : '—'}</td>
                      <td>{row.robustZ !== undefined ? Number(row.robustZ).toFixed(2) : '—'}</td>
                      <td>{typeof row.prob === 'number' ? `${(row.prob * 100).toFixed(1)}%` : '—'}</td>
                      <td>
                        <span class:list={['action-pill', row.status.includes('filled') ? 'entry' : row.isGateAllowed ? 'neutral' : 'exit']}>
                          {row.status.includes('filled') ? 'Filled' : row.isGateAllowed ? 'Screen Passed' : 'Filtered'}
                        </span>
                      </td>
                      <td style="font-size:12px; max-width:260px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{row.reason}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {/* 4. Active Portfolio Snapshot */}
        <section class="trades-section" style="padding-top: 18px;">
          <div class="section-heading">
            <div>
              <h2>Active Open Positions & Working Orders</h2>
              <p>Reconciled portfolio state for this session</p>
            </div>
          </div>
          {activePositions.length > 0 || openOrders.length > 0 ? (
            <div style="display:flex; flex-direction:column; gap:12px;">
              {activePositions.map((pos: any) => (
                <div style="background:#eeeee8; padding:16px 20px; border-radius:4px; display:flex; justify-content:space-between; align-items:center;">
                  <div>
                    <strong style="font-size:15px; margin-right:10px;">{pos.symbol ?? pos.ticker}</strong>
                    <span style="font-size:12px; color:var(--muted);">{pos.qty ?? pos.quantity} contracts · Expiration {pos.expiration}</span>
                  </div>
                  <div>
                    <span class="action-pill">Short ${pos.short_strike} / Long ${pos.long_strike}</span>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="empty-state">No active positions or pending orders recorded for this session.</div>
          )}
        </section>
      </div>
    ) : (
      <div class="entry-stack">
        {entry.entries.map((item) => {
          const readout = readoutFor(item);
          return (
            <article class="entry-card">
              <div class="entry-meta">
                <span>{readout.label}</span>
                <span class:list={['action-pill', readout.status.includes('exit') ? 'exit' : '']}>{readout.status}</span>
              </div>
              <h2>{readout.headline}</h2>
              <p class="readout-body">{readout.body}</p>
            </article>
          );
        })}
      </div>
    )}
  </article>
</Shell>
